{
  "name": "larmhub-api",
  "version": "0.3.34",
  "description": "API backend LarmHub / Santa Clara HUB",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:migrate:plano-contas": "node scripts/migrate_plano_contas.js",
    "db:seed:plano-contas": "node scripts/seed_plano_contas.js",
    "db:migrate:movimento": "node scripts/migrate_movimento_bancario.js",
    "db:seed:movimento:2021": "python3 scripts/import_financeiro.py movimento scripts/imports/movimento-bancario-2021.xlsx --ano=2021 --limpar",
    "db:seed:movimento:2022": "python3 scripts/import_financeiro.py movimento scripts/imports/mov-bancario-2022.xlsx --ano=2022 --limpar",
    "db:seed:movimento:2023": "python3 scripts/import_financeiro.py movimento scripts/imports/mov-bancario-2023.xlsx --ano=2023 --limpar",
    "db:seed:movimento:2024": "python3 scripts/import_financeiro.py movimento scripts/imports/mov-bancario-2024.xlsx --ano=2024 --limpar",
    "db:seed:movimento:2025": "python3 scripts/import_financeiro.py movimento scripts/imports/mov-bancario-2025.xlsx --ano=2025 --limpar",
    "db:seed:movimento:2026": "python3 scripts/import_financeiro.py movimento scripts/imports/mov-bancario-2026.xlsx --ano=2026 --ate=2026-06-28 --limpar",
    "db:seed:fornecedores:movimento": "node scripts/seed_fornecedores_movimento.js",
    "db:migrate:fornecedor-contratos": "node scripts/migrate_fornecedor_contratos.js",
    "db:seed:contas-pagar:2026": "python3 scripts/import_contas_pagar_futuro.py scripts/imports/2026-contas-pagar.xlsx --ano=2026 --de=2026-06-29",
    "db:seed:contas-pagar:2026:limpar": "python3 scripts/import_contas_pagar_futuro.py scripts/imports/2026-contas-pagar.xlsx --ano=2026 --de=2026-06-29 --limpar-importados",
    "db:migrate:orcamento": "node scripts/migrate_orcamento_financeiro.js",
    "db:seed:orcamento:2026": "python3 scripts/import_orcamento_2026.py scripts/imports/orcamento-movimento-2026.xlsx --ano=2026 --limpar",
    "db:preview:movimento-futuro-2026": "node scripts/limpar_movimento_futuro_2026.js",
    "db:limpar:movimento-futuro-2026": "node scripts/limpar_movimento_futuro_2026.js --execute",
    "db:migrate:impostos-retidos-cp": "node scripts/migrate_impostos_retidos_cp.js",
    "db:migrate:indices-economicos": "node scripts/migrate_indices_economicos.js",
    "db:seed:indices-economicos": "node scripts/seed_indices_economicos.js",
    "db:migrate:bloqueio-documento-duplicado-cp": "node scripts/migrate_bloqueio_documento_duplicado_cp.js",
    "db:migrate:substituicao-movimentos-2026": "node scripts/migrate_substituicao_movimentos_2026.js",
    "db:preview:substituir-movimentos:2026": "python3 scripts/substituir_movimentos_2026.py scripts/imports/movimento-bancario-2026-atualizado.xlsx scripts/imports/movimento-bancario-2026-orcado-atualizado.xlsx --ano=2026 --ate=2026-06-28 --preview",
    "db:substituir:movimentos:2026": "python3 scripts/substituir_movimentos_2026.py scripts/imports/movimento-bancario-2026-atualizado.xlsx scripts/imports/movimento-bancario-2026-orcado-atualizado.xlsx --ano=2026 --ate=2026-06-28 --execute",
    "db:migrate:documentos-parcelas-cp": "node scripts/migrate_documentos_parcelas_cp.js"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.750.0",
    "@aws-sdk/client-sns": "^3.750.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
